VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
VITE_NICE_API_ENABLED=false
VITE_EASYCLOUD_API_ENABLED=false
VITE_AI_DOCUMENT_PROCESSING_ENABLED=false
# Server-side only placeholders. Do not expose these in Vite frontend code:
# NICE_API_KEY=store-in-supabase-edge-function-secrets
# EASYCLOUD_API_KEY=store-in-supabase-edge-function-secrets
# OPENAI_API_KEY=store-in-supabase-edge-function-secrets

# EasyLog / EasyCloud API secrets must NOT be placed in Vite env files.
# Store these as Supabase Edge Function secrets instead:
# EASYCLOUD_API_TOKEN=server_side_only
# EASYCLOUD_USER_GUID=server_side_only
# EASYCLOUD_BASE_URL=https://apiwww.easylogcloud.com
